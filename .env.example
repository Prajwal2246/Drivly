# PostgreSQL Database connection string
# Local / Preview: use a non-production DB.
# Vercel Production: set DATABASE_URL to the Supabase transaction pooler URI (…pooler…:6543).
# For `npx prisma db push` from your laptop, temporarily use the direct URI (db.…:5432) — pooler often hangs.
# Do not also set POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING / POSTGRES_URL on Vercel while using this app’s db.ts
# (those override DATABASE_URL and have caused TLS / wrong-host failures).
DATABASE_URL="postgresql://username:password@localhost:5432/drivly_db"

# Admin Dashboard Password (used to access the /admin page)
ADMIN_PASSWORD="change_this_to_a_secure_password"

# Cryptographic secret for signing JWT session cookies (at least 32 characters)
ADMIN_SESSION_SECRET="your_secure_random_jwt_signing_secret_key_here"

# Optional: enable passwordless demo login only on Preview when gating is implemented
# DEMO_LOGIN="true"
