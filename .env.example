# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/drivly_db?schema=public"

# Password for the /admin dashboard
ADMIN_PASSWORD="change-me"

# HS256 secret for signing session cookies. At least 32 chars. Generate: openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# Supabase Storage (private bucket named `dl` must exist). Project Settings → API.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
